{
  "name": "migration-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run minify-css",
    "minify-css": "postcss dist/css/*.css --replace --no-map",
    "test:seo": "node scripts/check-seo.mjs",
    "preview": "astro preview",
    "astro": "astro",

---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { t } from "../i18n";

const pressKit = (await getCollection("pressKit")).map((entry) => entry.data);

const articles = (await getCollection("pressArticles")).map((e) => e.data);
const years = [...new Set(articles.map((a) => a.year))].sort((a, b) => b - a);
const press = years.map((year) => ({
    year,
    articles: articles
        .filter((a) => a.year === year)
        .sort((a, b) => a.rank - b.rank),
}));
---

<Layout title="On parle de nous /" currSection="press">
    <article class="page-body">
        <h2>{t("page.press")}</h2>

        <h3>{t("page.pressForJournalists")}</h3>
        <dl class="press">
            {
                pressKit.map((doc) => (
                    <div>
                        <dt>
                            <a href={doc.url}>{doc.title}</a>
                        </dt>
                        <dd>
                            {t("page.pressPublishedOn", { at: doc.publishedAt })}
                        </dd>
                    </div>
                ))
            }
        </dl>

        {
            press.map(({ year, articles }) => (
                <>
                    <h3>{year}</h3>
                    <dl class="press">
                        {articles.map((article) => (
                            <div class={article.type}>
                                <dt>
                                    <a href={article.url}>{article.title}</a>
                                </dt>
                                <dd>
                                    {t("page.pressPublished", {
                                        by: article.publishedBy,
                                        at: article.publishedAt,
                                    })}
                                </dd>
                            </div>
                        ))}
                    </dl>
                </>
            ))
        }
    </article>
</Layout>

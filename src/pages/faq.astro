---
import Layout from "../layouts/Layout.astro";
import { renderFaqResponse } from "../core/faq";
import { dataSource } from "../data";

const qanda = (await dataSource.getFaq()).map((entry) => ({
    ...entry,
    response: renderFaqResponse(entry),
}));
---

<Layout title="Foire aux questions /" currSection="faq">
    <article class="page-body">
        <h2>Foire aux questions</h2>
        {
            qanda.map((faq) => {
                return (
                    <div class="faq" id={`faq${faq.order}`}>
                        <h3>
                            {faq.question}
                            <a href={`/faq/index.html#faq${faq.order}`}>
                                <img src="/img/link.svg" alt="Ancre" />
                            </a>
                        </h3>
                        <div class="content">
                            <p>
                                <Fragment set:html={faq.response} />
                            </p>
                        </div>
                    </div>
                );
            })
        }
    </article>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import JobCard from "../components/JobCard.astro";
import { dataSource } from "../data";
import { t } from "../i18n";

const jobs = await dataSource.getJobs();
---

<Layout title={t("jobs.title")} currSection="offres">
  <div class="page-body">
    <article class="h-entry">
      <h2 class="p-name">{t("jobs.title")}</h2>

      <div class="intro">
        <p>{t("jobs.intro")}</p>
      </div>

      <div class="job-offers">
        {jobs.map((job) => (
          <JobCard job={job} partnerName={job.partnerName} />
        ))}
        {jobs.length === 0 && (
          <p>{t("jobs.empty")}</p>
        )}
      </div>
    </article>
  </div>
</Layout>

---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import JobCard from "../components/JobCard.astro";
import SponsorActivities from "../components/SponsorActivities.astro";
import SocialList from "../components/SocialList.astro";
import { ogImageUrl, site } from "../config";
import { t } from "../i18n";

interface Props {
    sponsor: CollectionEntry<"sponsors">;
}

export const getStaticPaths = (async () => {
    const sponsors = await getCollection("sponsors");

    return sponsors.map((sponsor) => ({
        params: { id: sponsor.data.id },
        props: { sponsor },
    }));
}) satisfies GetStaticPaths;

const { sponsor } = Astro.props;
const { jobs, speakerIds } = sponsor.data;

const allTalks = await getCollection("talks");
const partnerTalks =
    speakerIds.length > 0
        ? allTalks.filter((t) =>
              t.data.speakers.some((s) => speakerIds.includes(s.id)),
          )
        : [];

const og = {
    ogDescription: sponsor.data.description?.replaceAll('"', "")?.trim(),
    ogUrl: `${site.url}/partner-${sponsor.data.id}`,
    ogImage: sponsor.data.logoUrl || ogImageUrl,
};

const video = sponsor.data.videoUrl;
---

<Layout title={sponsor.data.name} currSection="partners" og={og}>
    <div class="page-body">
        <div class="h-group sponsor">
            <p class="sponsor">
                {
                    sponsor.data.siteUrl ? (
                        <a
                            href={sponsor.data.siteUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <img
                                loading="lazy"
                                src={sponsor.data.logoUrl}
                                alt={t("sponsors.logoAlt", { name: sponsor.data.name })}
                            />
                        </a>
                    ) : (
                        <img
                            loading="lazy"
                            src={sponsor.data.logoUrl}
                            alt={t("sponsors.logoAlt", { name: sponsor.data.name })}
                        />
                    )
                }
            </p>
            <div class="with-contact">
                <h2>{sponsor.data.name}</h2>
                <SocialList
                    socials={sponsor.data.socials}
                    siteUrl={sponsor.data.siteUrl}
                />
            </div>
        </div>

        <div class="sponsor-sheet">
            <div class="description">
                {
                    sponsor.data.description && (
                        <div class="content">
                            <p>
                                {sponsor.data.description
                                    ?.replaceAll('"', "")
                                    ?.trim() ?? ""}
                            </p>
                        </div>
                    )
                }

                {
                    video && (
                        <video
                            controls
                            preload="metadata"
                            class="sponsor-video"
                        >
                            <source src={video} />
                        </video>
                    )
                }
            </div>

            {
                partnerTalks.length > 0 && (
                    <div class="the-talks">
                        <h3>{t("sponsors.talksHeading")}</h3>
                        <ul>
                            {partnerTalks.map((talk) => (
                                <li>
                                    <strong>
                                        <a href={`/talk-page-${talk.id}`}>
                                            {talk.data.title}
                                        </a>
                                    </strong>
                                    {talk.data.speakers
                                        .map((s) => s.name)
                                        .join(" & ")}
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }

            <SponsorActivities partnerId={sponsor.data.id} />

            {
                jobs.length > 0 && (
                    <details class="job-offers">
                        <summary>
                            <h2>{t("sponsors.jobsHeading", { name: sponsor.data.name })}</h2>
                        </summary>
                        <div class="content">
                            {jobs.map((job) => (
                                <JobCard
                                    job={job}
                                    partnerName={sponsor.data.name}
                                />
                            ))}
                        </div>
                    </details>
                )
            }
        </div>
    </div>
</Layout>

<style>
    /*
     * Le socle stylise déjà `.h-group.sponsor p` avec la même spécificité ;
     * on nomme donc l'ancêtre pour l'emporter quel que soit l'ordre
     * d'émission des feuilles.
     */
    .h-group.sponsor p.sponsor {
        box-sizing: border-box;
        min-width: 80px;
        background-color: var(--text-high);
        padding: 0.5rem;
        margin: 0 auto 2rem auto;
        border-radius: 100%;

        & a {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100px;
            height: 100px;
            margin: 1rem;
        }
    }

</style>
---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { renderMarkdown } from "../core/markdown";
import PartnerBlock from "../components/PartnerBlock.astro";
import FavoriteButton from "../components/FavoriteButton.astro";

interface Props {
    talk: CollectionEntry<"talks">;
}

export const getStaticPaths = (async () => {
    const talks = await getCollection("talks");

    return talks.map((talk) => ({
        params: {
            id: talk.id,
        },
        props: {
            talk: talk,
        },
    }));
}) satisfies GetStaticPaths;

const { talk } = Astro.props;

const og = {
    ogDescription: talk.data.title?.replaceAll('"', ""),
    ogUrl: "https://devlille.fr/talk-page-" + talk.id,
    ogImage: talk.data.speakers[0]?.photoUrl,
};

const speakers = talk.data.speakers;

const partners = [
    ...new Map(
        speakers.flatMap((s) => s.partners).map((p) => [p.id, p]),
    ).values(),
];

// Le titre du talk occupe le `h2` de la page : les titres du résumé descendent
// donc d'un niveau (`# ` -> `<h2>`), comme le faisait l'ancien `shiftHeadings`.
const abstract = renderMarkdown(talk.data.abstract, { headingOffset: 1 });
---

<Layout title={talk.data.title} currSection="talks" og={og}>
    <div class="page-body list">
        <div class="talk-sheet">
            <div class="talk-top">
                <div class="description">
                    <div class="h-group">
                        <h2>{talk.data.title}</h2>
                        <FavoriteButton talkId={talk.id} sessionId={talk.data.sessionId} />
                    </div>
                    <Fragment set:html={abstract} />
                </div>
                <div class="talk-data-block card">
                    <h3>Présenté par :</h3>
                    {
                        speakers?.map((s) => {
                            return (
                                <p class="s-photo">
                                    <img
                                        loading="lazy"
                                        width="100"
                                        height="100"
                                        src={s.photoUrl}
                                        alt={`Photo de ${s.name}`}
                                    />
                                    <a href={`/speaker-page-${s.id}`}>
                                        {s.name}
                                    </a>
                                </p>
                            );
                        })
                    }
                </div>

                <PartnerBlock partners={partners} className="talk-partners" />
            </div>

            {
                (talk.data.openFeedbackUrl || talk.data.slidesUrl) && (
                    <div class="talk-material">
                        <div class="content">
                            {talk.data.slidesUrl && (
                                <div class="talk-links">
                                    <h4>Regardez ou re-regardez</h4>
                                    <ul>
                                        {talk.data.replayUrl && (
                                            <li>
                                                <a href={talk.data.replayUrl}>
                                                    La vidéo du talk
                                                </a>
                                            </li>
                                        )}

                                        {talk.data.slidesUrl && (
                                            <li>
                                                <a href={talk.data.slidesUrl}>
                                                    Les slides du talk
                                                </a>
                                            </li>
                                        )}
                                    </ul>
                                </div>
                            )}
                            {talk.data.openFeedbackUrl && (
                                <p class="openfb">
                                    Suite à la conférence, vous pouvez faire
                                    un retour aux conférenciers et
                                    conférencières sur
                                    <a
                                        href={talk.data.openFeedbackUrl}
                                        target="_blank"
                                    >
                                        OpenFeedback
                                    </a>
                                </p>
                            )}
                        </div>
                    </div>
                )
            }
        </div>
    </div>
</Layout>

---
import { event, features, integrations, lang, site, ticketsUrl } from "../config";
import { buildEventJsonLd } from "../core/event-jsonld";
import { pickOneWithSeed } from "../core/pick";
import { t } from "../i18n";
import Sponsors from "../components/sponsors.astro";
import PartnershipLink from "../components/partnership-link.astro";
import Footer from "../components/Footer.astro";
import MainNav from "../components/MainNav.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

const { title, currSection, og = {} } = Astro.props;
const { ogTitle, ogDescription, ogUrl, ogImage } = og;

// Tirage stable sur l'édition : le verbatim change d'une année à l'autre, pas
// d'un build à l'autre.
const verbatim = await getCollection("verbatims");
const editionVerbatim = pickOneWithSeed(verbatim, `verbatim-${event.edition}`)!;
const { Content } = await render(editionVerbatim);

const jsonld = buildEventJsonLd(site, event, ticketsUrl);

const logoAlt = t("layout.logoAlt", {
    site: site.name,
    edition: event.edition,
});

const titleSuffix = t("layout.titleSuffix", {
    site: site.name.toUpperCase(),
    edition: event.edition,
});
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="keywords" content={site.keywords.join(", ")} />
        <meta name="description" content={ogDescription} />
        <meta name="theme-color" content={site.themeColor} />
        <meta property="og:url" content={ogUrl} />
        <meta property="og:title" content={ogTitle ?? title} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:image" content={ogImage} />

        <link href="/img/favicon.svg" type="image/svg+xml" rel="icon" />
        <link href="/img/favicon.png" type="image/png" rel="icon" />
        <title>{`${title} - ${titleSuffix}`}</title>

        <!-- ✅ Correct CSS Path -->
        <link rel="stylesheet" href="/css/main.css" />
        <link rel="stylesheet" href="/css/queries.css" />

        <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

        <link rel="manifest" href="/manifest.json" />
    </head>

    <body id={currSection === "index" ? "home" : ""}>
        <div id="container">
            <!-- 🏠 Page Header -->
            <header>
                <h1>
                    {
                        currSection === "index" ? (
                            <img src="/img/logodl.svg" alt={logoAlt} />
                        ) : (
                            <a
                                href="/index.html"
                                aria-label={t("layout.home", {
                                    site: site.name,
                                })}
                            >
                                <img src="/img/logodl.svg" alt={logoAlt} />
                            </a>
                        )
                    }
                </h1>
                <!-- 🗂️ Navigation -->
                <MainNav currSection={currSection} />

                {
                    features.tickets && (
                        <p class="register">
                            <a
                                rel="noreferrer noopener"
                                target="_blank"
                                href={ticketsUrl}
                            >
                                {t("layout.tickets")}
                            </a>
                        </p>
                    )
                }
            </header>

            <!-- 📌 Injecting Page-Specific Content -->
            <div id="wrapper">
                <main>
                    <slot />
                </main>

                {
                    currSection == "index" && (
                        <aside>
                            <div class="be-partner">
                                <h2>{t("layout.becomePartner")}</h2>

                                <div>
                                    <blockquote>
                                        <Content />
                                        <p>
                                            &mdash; {editionVerbatim.data.name}
                                        </p>
                                    </blockquote>
                                </div>

                                {integrations.partnershipDeck.map((deck) => (
                                    <PartnershipLink
                                        url={deck.url}
                                        text={deck.label}
                                    />
                                ))}
                            </div>
                            {features.sponsoring && (
                                <div class="content filled" id="partners">
                                    <h2>
                                        {t("layout.partnersThanks", {
                                            edition: event.edition,
                                        })}
                                    </h2>

                                    <Sponsors />
                                </div>
                            )}
                        </aside>
                    )
                }
            </div>

            <Footer />
        </div>

        <!-- 🛠️ Service Worker -->
        <script>
            if ("serviceWorker" in navigator) {
                window.addEventListener("load", function () {
                    navigator.serviceWorker.register("/sw.js");
                });
            }
        </script>
    </body>
</html>

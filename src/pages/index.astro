---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { event, site } from "../config";
import { t } from "../i18n";
import YoutubeVideos from "../components/youtube-videos.astro";
import Illustration from "../components/Illustration.astro";

const og = {
    ogTitle: site.name,
    ogDescription: t("og.home", { site: site.name }),
    ogImage: `${site.url}/img/logo-full.svg`,
};

/** Les sections éditoriales, dans l'ordre déclaré par leur frontmatter. */
const sections = await Promise.all(
    (await getCollection("sections"))
        .sort((a, b) => a.data.order - b.data.order)
        .map(async (entry) => ({
            ...entry.data,
            Body: (await render(entry)).Content,
        })),
);

const venueSections = sections.filter((s) => s.variant === "venue");
const decorSections = sections.filter((s) => s.variant === "decor");

const stats = [
    { value: event.stats.attendees, label: t("home.attendees") },
    { value: event.stats.speakers, label: t("home.speakers") },
    { value: event.stats.talks, label: t("home.talks") },
    { value: event.stats.tracks, label: t("home.tracks"), lang: "en" },
];
---

<Layout title={site.name} currSection="index" og={og}>
    <div class="hero">
        <p>
            <img
                src="/img/home-2026.svg"
                width="512"
                alt={`${site.name} Année ${event.edition}`}
                fetchpriority="high"
            />
        </p>
        <p class="where-n-when">
            <time datetime={event.startDate}>
                {event.dateLabel}
            </time>
            <span>{event.venue.displayName}</span>
        </p>
    </div>

    <div class="group">
        <div class="stats">
            <h2 class="no-display">
                {
                    t("home.statsTitle", {
                        site: site.name,
                        edition: event.edition,
                    })
                }
            </h2>
            <ul>
                {
                    stats.map((stat) => (
                        <li>
                            <strong>{stat.value}</strong>
                            <span lang={stat.lang}>{stat.label}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <div class="with-news">
        {
            venueSections.map((section) => (
                <div class="venue">
                    <p class="illustration">
                        <Illustration image={section.illustrations[0]} />
                    </p>
                    <div class="content">
                        <h2>
                            {section.title}
                            {section.titleHighlight && (
                                <Fragment>
                                    {" "}
                                    <strong>{section.titleHighlight}</strong>
                                </Fragment>
                            )}
                        </h2>
                        <section.Body />
                        {section.link && (
                            <p class="read-more">
                                <a
                                    rel={
                                        section.link.external
                                            ? "noreferrer noopener"
                                            : undefined
                                    }
                                    target={
                                        section.link.external
                                            ? "_blank"
                                            : undefined
                                    }
                                    href={section.link.href}
                                >
                                    {section.link.label}
                                </a>
                            </p>
                        )}
                    </div>
                    {section.illustrations[1] && (
                        <p class="illustration secondary">
                            <Illustration image={section.illustrations[1]} />
                        </p>
                    )}
                </div>
            ))
        }

        <div class="fixed">
            {
                decorSections.map((section) => (
                    <div class="decor">
                        <p class="illustration">
                            <Illustration image={section.illustrations[0]} />
                        </p>
                        <div class="content">
                            <h2>{section.title}</h2>
                            <section.Body />
                        </div>
                    </div>
                ))
            }
        </div>

        <YoutubeVideos />
    </div>

    <script>
        const stats = document.querySelector("div.stats");
        const venue = document.querySelector("div.venue");
        const partner = document.querySelector("div.be-partner p.read-more");

        if (stats) {
            const observer = new window.IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        stats.classList.add("active");
                        return;
                    }
                    //stats.classList.remove('active');
                },
                {
                    root: null,
                    threshold: 0.5, // set offset 0.1 means trigger if atleast 10% of element in viewport
                },
            );
            observer.observe(stats);
        }

        if (venue) {
            const observer2 = new window.IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        venue.classList.add("active");
                        return;
                    }
                    //venue.classList.remove('active');
                },
                {
                    root: null,
                    threshold: 1,
                },
            );
            observer2.observe(venue);
        }

        if (partner) {
            const observer3 = new window.IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        partner.classList.add("active");
                        return;
                    }
                    //partner.classList.remove('active');
                },
                {
                    root: null,
                    threshold: 1,
                },
            );
            observer3.observe(partner);
        }
    </script>
</Layout>

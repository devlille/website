---
import { getCollection } from "astro:content";
import { event, features, integrations, site } from "../config";
import { t } from "../i18n";
import Newsletter from "./Newsletter.astro";

const editions = (await getCollection("editions"))
    .map((entry) => entry.data)
    .sort((a, b) => b.year - a.year);

/** Un lien de pied de page peut être conditionné à un drapeau d'instance. */
const footerLinks = site.footerLinks.filter(
    (link) => !link.feature || features[link.feature],
);
---

<footer>
    <div class="content">
        <dl class="h-event">
            <dt class="p-name">
                {t("footer.eventName", {
                    site: site.name,
                    edition: event.edition,
                })}
            </dt>
            <dd class="p-summary">{event.tagline}</dd>
        </dl>
        <Newsletter
            newsletter={integrations.newsletter}
            title={t("footer.newsletterTitle", { site: site.name })}
            emailLabel={t("footer.email")}
            submitLabel={t("footer.subscribe")}
        />

        <div class="footer-links">
            <ul class="links-list">
                {
                    footerLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                target={link.external ? "_blank" : undefined}
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <ul class="links-list editions">
                {
                    editions.map((edition) => (
                        <li>
                            <a href={edition.url}>{edition.year}</a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
    <div class="related">
        <ul class="sm-list">
            {
                site.socials.map((social) => (
                    <li class="show-icons">
                        <a href={social.url}>
                            <svg role="img" width="24" height="24">
                                <title>{social.label}</title>
                                <use href={`/img/sprite.svg#${social.icon}`} />
                            </svg>
                        </a>
                    </li>
                ))
            }
        </ul>
        <p class="copyright">
            {t("footer.copyright", { site: site.name, edition: event.edition })}
        </p>
    </div>
</footer>

---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
const speakersFromApi = (await getCollection("speakers")).map((d) => ({ id: d.id, ...d.data }));
import { renderMarkdown } from "../core/markdown";
import { t } from "../i18n";
---

<Layout title="Speakers /" currSection="speakers">
    <div class="page-body list">
        <h2>{t("page.speakers")}</h2>

        <div class="all-speakers">
            <ul>
                {
                    speakersFromApi.map((speaker) => {
                        return (
                            <li>
                                <p class="s-photo">
                                    <img
                                        loading="lazy"
                                        width="100"
                                        height="100"
                                        src={speaker.photoUrl}
                                        alt={t("speaker.photoAlt", { name: speaker.name })}
                                    />
                                </p>
                                <h3>
                                    <a href={`/speaker-page-${speaker.id}`}>
                                        {speaker.name}
                                    </a>
                                </h3>
                                <p>
                                    <Fragment
                                        set:html={renderMarkdown(speaker.bio)}
                                    />
                                </p>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </div>
</Layout>

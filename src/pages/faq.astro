---
import Layout from "../layouts/Layout.astro";
import { marked } from "marked";
import { dataSource } from "../data";

const qanda = (await dataSource.getFaq()).map((entry) => ({
    ...entry,
    response: entry.acronyms.reduce(
        (acc, { key, value }) =>
            acc.replace(key, `<abbr title="${value}">${key}</abbr>`),

        entry.actions.reduce(
            (acc, { label, url }) =>
                acc.replace(
                    new RegExp(label, "ig"),
                    `<a href="${url}">${label}</a>`,
                ),
            marked(entry.response.replaceAll("* ", "\r\n\r\n* ")) as string,
        ),
    ),
}));
---

<Layout title="Foire aux questions /" currSection="faq">
    <article class="page-body">
        <h2>Foire aux questions</h2>
        {
            qanda.map((faq) => {
                return (
                    <div class="faq" id={`faq${faq.order}`}>
                        <h3>
                            {faq.question}
                            <a href={`/faq/index.html#faq${faq.order}`}>
                                <img src="/img/link.svg" alt="Ancre" />
                            </a>
                        </h3>
                        <div class="content">
                            <p>
                                <Fragment set:html={faq.response} />
                            </p>
                        </div>
                    </div>
                );
            })
        }
    </article>
</Layout>

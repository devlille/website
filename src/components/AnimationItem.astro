---
import type { ActivitySlotEntry } from "../core/activities";

interface Props {
    item: ActivitySlotEntry;
}

const { item: activity } = Astro.props;
---

<dl data-activity-id={activity.id}>
    <dt>{activity.displayRange}</dt>
    <dd class="event-session animation">
        <a href={`/partner-${activity.partnerId}`}>{activity.name}</a>
    </dd>
    <dd>
        {activity.partnerName}
    </dd>
</dl>

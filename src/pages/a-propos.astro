---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { ogImageUrl, site } from "../config";
import { t } from "../i18n";

const og = {
    ogTitle: `${site.name} - A propos`,
    ogDescription: t("og.about", { site: site.name }),
    ogImage: ogImageUrl,
};

const team = await Promise.all(
    (await getCollection("team"))
        .sort((a, b) => a.data.order - b.data.order)
        .map(async (entry) => ({
            ...entry.data,
            Bio: (await render(entry)).Content,
        })),
);

const highlight = await getEntry("blocks", "team-highlight");
const { Content: Highlight } = await render(highlight!);

const title = t("page.team", { site: site.name });
---

<Layout title={title} currSection="apropos" og={og}>
    <div class="page-body">
        <h2>{title}</h2>

        <div class="team">
            {
                team.map((member) => (
                    <section class="member">
                        <div class="hgroup">
                            <h3>{member.name}</h3>
                            <p class="illustration">
                                <img
                                    loading="lazy"
                                    src={member.photo}
                                    alt=""
                                />
                            </p>
                        </div>
                        <div class="content">
                            <member.Bio />
                        </div>
                    </section>
                ))
            }

            <div class="highlight">
                <Highlight />
            </div>
        </div>
    </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";
import TalkItem from "../components/TalkItem.astro";
import FavoritesSwitch from "../components/FavoritesSwitch.astro";
import { createTalksCollectionsBydate } from "../utils/getTalksByDate";
import { event, site } from "../config";
import { t } from "../i18n";

const og = {
    ogTitle: `${site.name} - ${t("page.agenda")}`,
    ogUrl: `${site.url}/agenda`,
    ogDescription: t("og.agenda", { tagline: event.tagline }),
    ogImage: `${site.url}/img/logo-full.svg`,
};

const talksByDate = await createTalksCollectionsBydate();
---

<Layout title="Agenda /" currSection="agenda" og={og}>
    <div class="page-body">
        <h2 class="with-favs">
            {t("page.agenda")}
            <FavoritesSwitch />
        </h2>

        <Timeline data={talksByDate} ItemComponent={TalkItem} />
    </div>
</Layout>

---
import type { Job } from "../data/domain";
import { t, locale } from "../i18n";

interface Props {
    job: Job;
    partnerName?: string;
}

const { job, partnerName } = Astro.props;
---

<section class="h-listing">
    <header>
        <h3 class="p-action wanted">
            <a
                href={job.url}
                class="u-url"
                target="_blank"
                rel="noopener noreferrer">{partnerName} - {job.title}</a
            >
        </h3>
        <p class="dt-location">{job.location}</p>
    </header>
    {
        (job.requirements || job.salary) && (
            <dl>
                {job.requirements !== null && job.requirements > 0 && (
                    <div>
                        <dt>{t("job.experience")}</dt>
                        <dd>{t("job.minYears", { years: job.requirements })}</dd>
                    </div>
                )}
                {job.salary && (
                    <div>
                        <dt>{t("job.salary")}</dt>
                        <dd>
                            {t("job.salaryRange", {
                                min: job.salary.min.toLocaleString(locale),
                                max: job.salary.max.toLocaleString(locale),
                            })}
                        </dd>
                    </div>
                )}
            </dl>
        )
    }
</section>

---
import { getCollection } from "astro:content";
import { groupSponsorsByTier } from "../core/sponsor-tiers";
import Pack from "../components/pack.astro";

const sponsors = (await getCollection("sponsors")).map((c) => c.data);
const tiers = groupSponsorsByTier(sponsors);
---

{tiers.map((tier) => <Pack title={tier.title} partners={tier.partners} />)}

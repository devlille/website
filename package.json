    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "astro": "^7.0.3",
    "marked": "^17.0.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@types/isurl": "^4.0.0",
    "@types/node": "^24.9.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^5.0.0",
    "astro-robots-txt": "^1.0.0",
    "cssnano": "^7.1.2",
    "dayjs": "^1.11.19",
    "isurl": "^4.0.2",
    "knip": "^6.4.1",
    "lightningcss": "^1.31.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "terser": "^5.46.0",
    "vitest": "^5.0.0"
  }

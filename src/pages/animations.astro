---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";
import AnimationItem from "../components/AnimationItem.astro";
import { createActivitiesCollectionsByDate } from "../utils/getActivitiesByDate";
import { ogImageUrl, site } from "../config";
import { t } from "../i18n";

const og = {
    ogTitle: `${site.name} - ${t("page.animations")}`,
    ogUrl: `${site.url}/animations`,
    ogDescription: t("og.animations", { site: site.name }),
    ogImage: ogImageUrl,
};

const activitiesByDate = await createActivitiesCollectionsByDate();
---

<Layout title="Animations /" currSection="animations" og={og}>
    <div class="page-body">
        <h2>{t("page.animations")}</h2>

        <Timeline
            data={activitiesByDate}
            ItemComponent={AnimationItem}
            autoScrollToHour={false}
        />
    </div>
</Layout>

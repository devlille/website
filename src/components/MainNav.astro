---
import { site } from "../config";
import { t } from "../i18n";

const { currSection } = Astro.props;
---

<nav class="main-nav">
    <h2 class="k-skip">
        <a href="#wrapper">{t("nav.skip")}</a>
    </h2>
    <ul>
        {
            site.nav.map((item) => (
                <li>
                    <a
                        href={item.href}
                        aria-current={currSection === item.section && "page"}
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

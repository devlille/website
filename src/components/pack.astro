---
import type { Partner } from "../data/domain";
import { t } from "../i18n";

interface Props {
    title: string;
    partners: Partner[];
}

const { title, partners: unsorted } = Astro.props;
const partners = (unsorted ?? []).sort((p1, p2) => {
    return p1.name.toLowerCase().localeCompare(p2.name.toLowerCase());
});
---

<div class="sponsors gold">
    <h3>{title}</h3>

    <ul>
        {
            partners.map((p) => {
                return (
                    <li class="sponsor">
                        <a
                            aria-label={t("sponsors.visitSite", { name: p.name })}
                            href={`partner-${p.id}`}
                        >
                            <img src={p.logoUrl} alt={p.name} loading="lazy" />
                        </a>
                    </li>
                );
            })
        }
    </ul>
</div>

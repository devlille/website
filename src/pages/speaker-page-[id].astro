---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { renderMarkdown } from "../core/markdown";
import PartnerBlock from "../components/PartnerBlock.astro";
import SocialList from "../components/SocialList.astro";
import { event, site } from "../config";
import { t } from "../i18n";

interface Props {
    speaker: CollectionEntry<"speakers">;
}

export const getStaticPaths = (async () => {
    const speakers = await getCollection("speakers");

    return speakers.map((speaker) => ({
        params: {
            id: speaker.id,
        },
        props: {
            speaker: speaker,
        },
    }));
}) satisfies GetStaticPaths;

const { speaker } = Astro.props;

const speakerName = speaker.data.name || t("speaker.fallbackName");

const stripMarkdown = (text: string): string =>
    text
        .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
        .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
        .replace(/[*_`~#>]+/g, "")
        .replace(/\s+/g, " ")
        .trim();

const truncate = (text: string, max = 160): string =>
    text.length > max ? text.slice(0, max - 1).trimEnd() + "…" : text;

const fallbackDescription = t("speaker.metaDescription", {
    name: speakerName,
    company: speaker.data.company ? ` (${speaker.data.company})` : "",
    site: site.name,
    edition: event.edition,
});

const metaDescription = speaker.data.bio
    ? truncate(stripMarkdown(speaker.data.bio))
    : fallbackDescription;

const og = {
    ogDescription: metaDescription,
    ogUrl: `${site.url}/speaker-page-${speaker.id}`,
    ogImage: speaker.data.photoUrl,
};

const talks = await getCollection("talks");

const selectedTalks = talks.filter((t) =>
    t.data.speakers.find((s) => s.id === speaker.id),
);
---

<Layout title={t("speaker.pageTitle", { name: speakerName })} currSection="speakers" og={og}>
    <div class="page-body list speaker-sheet">
        <div class="h-group">
            {
                speaker.data.photoUrl && (
                    <p class="s-photo">
                        <img
                            loading="lazy"
                            src={speaker.data.photoUrl}
                            alt={t("speaker.photoAlt", { name: speaker.data.name })}
                        />
                    </p>
                )
            }
            <h2>
                {speaker.data.name}{
                    speaker.data.pronouns ? ` (${speaker.data.pronouns})` : ""
                }
            </h2>
            <p>
                <span class="no-display">{t("speaker.company")}</span>
                {speaker.data.company ? speaker.data.company : ""}
            </p>
            <SocialList
                socials={speaker.data.socials}
                siteUrl={speaker.data.websiteUrl}
                class="social"
            />
        </div>

        <div class="speaker">
            <Fragment
                set:html={renderMarkdown(speaker.data.bio)}
            />
        </div>

        <div class="content">
            <div class="talks card">
                <h3>
                    <span lang="en">Talks</span> {
                        t("speaker.talksHeading", { name: speaker.data.name })
                    }
                </h3>
                {
                    selectedTalks.map((selectedTalk) => {
                        return (
                            <ul class="talk">
                                <li>
                                    <a href={`/talk-page-${selectedTalk.id}`}>
                                        {selectedTalk.data.title}
                                    </a>
                                </li>

                                {(!!selectedTalk.data.slidesUrl ||
                                    !!selectedTalk.data.replayUrl) && (
                                    <div class="talk-links">
                                        <h4>{t("talk.watchAgain")}</h4>
                                        <ul>
                                            {selectedTalk.data.replayUrl && (
                                                <li>
                                                    <a href={selectedTalk.data.replayUrl}>
                                                        {t("talk.replay")}
                                                    </a>
                                                </li>
                                            )}
                                            {selectedTalk.data.slidesUrl && (
                                                <li>
                                                    <a href={selectedTalk.data.slidesUrl}>
                                                        {t("talk.slides")}
                                                    </a>
                                                </li>
                                            )}
                                        </ul>
                                    </div>
                                )}

                                {/* <p>
                  <a href={`/talk-page-${selectedTalk.id}`}>
                    Page dédiée de ce talk
                  </a>
                </p> */}
                            </ul>
                        );
                    })
                }
            </div>

            <PartnerBlock partners={speaker.data.partners} className="speaker-partners" />
        </div>
    </div>
</Layout>
